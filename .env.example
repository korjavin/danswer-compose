# ===========================================
# Danswer / Onyx — Environment Configuration
# ===========================================

# --- Docker Images ---
# These point to GHCR-vendored images by default.
# To pin to a specific digest after vendoring, use:
#   API_IMAGE=ghcr.io/korjavin/danswer-backend-vendor@sha256:<digest>
API_IMAGE=ghcr.io/korjavin/danswer-backend-vendor:latest
WEB_IMAGE=ghcr.io/korjavin/danswer-web-vendor:latest
MODEL_IMAGE=ghcr.io/korjavin/danswer-model-vendor:latest
VESPA_IMAGE=ghcr.io/korjavin/danswer-vespa-vendor:latest
POSTGRES_IMAGE=postgres:15.2-alpine
REDIS_IMAGE=redis:7.4-alpine
MINIO_IMAGE=minio/minio:latest

# --- Container Names ---
WEB_CONTAINER_NAME=danswer-web
API_CONTAINER_NAME=danswer-api
BACKGROUND_CONTAINER_NAME=danswer-background
INFERENCE_MODEL_CONTAINER_NAME=danswer-inference-model
INDEXING_MODEL_CONTAINER_NAME=danswer-indexing-model
DB_CONTAINER_NAME=danswer-db
VESPA_CONTAINER_NAME=danswer-index
REDIS_CONTAINER_NAME=danswer-cache
MINIO_CONTAINER_NAME=danswer-minio

# --- Network Names ---
TRAEFIK_NETWORK_NAME=traefik_default
INTERNAL_NETWORK_NAME=danswer_internal

# --- Volume Names ---
DB_VOLUME_NAME=danswer_db-data
INDEX_VOLUME_NAME=danswer_index-data
MINIO_VOLUME_NAME=danswer_minio-data
MODEL_CACHE_VOLUME_NAME=danswer_model-cache
APP_DATA_VOLUME_NAME=danswer_app-data

# --- Traefik Configuration ---
SERVICE_HOST=danswer.yourdomain.com
TRAEFIK_CERTRESOLVER=myresolver

# --- Application Secrets ---
# Generate with: openssl rand -hex 32
DANSWER_SECRET=change-me-generate-with-openssl-rand-hex-32
ENCRYPTION_KEY_SECRET=change-me-generate-with-openssl-rand-hex-32

# --- OIDC / Auth (Authentik) ---
# AUTH_TYPE options: disabled, basic, google_oauth, oidc, saml
AUTH_TYPE=oidc
OAUTH_CLIENT_ID=<authentik-client-id>
OAUTH_CLIENT_SECRET=<authentik-client-secret>
# Authentik OIDC discovery URL — replace with your Authentik domain and app slug:
OPENID_CONFIG_URL=https://auth.yourdomain.com/application/o/danswer/.well-known/openid-configuration

# --- PostgreSQL ---
POSTGRES_DB=danswer
POSTGRES_USER=danswer
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-strong-password

# --- MinIO Object Storage ---
MINIO_ROOT_USER=minio_admin
# Generate with: openssl rand -hex 24
MINIO_ROOT_PASSWORD=change-me-to-strong-password
FILE_STORE_BACKEND=s3
S3_BUCKET_NAME=danswer-files

# --- Application Settings ---
LOG_LEVEL=info

# --- LLM Provider Keys (configure as needed in Danswer UI or here) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=...
# AZURE_OPENAI_DEPLOYMENT_NAME=...

# --- Future integrations (Outline, Mattermost) ---
# Danswer connectors for Outline and Mattermost are configured
# via the Danswer web UI after deployment (Admin → Connectors).
# You will need API tokens from each service.
# OUTLINE_API_TOKEN=   # from Outline Settings → API
# MATTERMOST_BOT_TOKEN=  # from Mattermost → Integrations → Bot Accounts

